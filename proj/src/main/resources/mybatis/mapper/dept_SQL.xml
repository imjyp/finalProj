<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.dept.jy.mapper.DeptMapper">
	
	<select id="listAll" resultType="kr.or.ddit.vo.DeptVO">
		SELECT DEPT_NO, DEPT_NM, AUTH_NO, DEPT_SUPRR
		FROM DEPT
		WHERE DEPT_STATE = 1
		ORDER BY DEPT_NO
	</select>
	
</mapper>