<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.itdmenuSG.mapper.ItdmenuMapper">

	<resultMap type="kr.or.ddit.vo.MenuVO" id="MenuMap">
		<result property="menuNo" column="menu_no" />
		<result property="menuNm" column="menu_nm" />
		<result property="ctgryNo" column="ctgry_no" />
		<result property="ctgryNm" column="ctgry_nm" />
		<result property="menuPrice" column="menu_price" />
		<result property="menuCn" column="menu_cn" />
		<result property="menuRegist" column="menu_regist" />
		<result property="menuDel" column="menu_del" />
		<association property="fileGroupVO" resultMap="fileGroupMap" column="file_group_no"/>

    <!-- 파일 리스트 매핑 -->
    <collection property="fileDetailList" ofType="kr.or.ddit.vo.FileDetailVO"
                column="file_group_no" resultMap="fileDetailMap"/>
		
	</resultMap>	
		
	<resultMap type="kr.or.ddit.vo.FileGroupVO" id="fileGroupMap">
		<result property="fileGroupNo" column="FILE_GROUP_NO"/>
		<result property="fileGroupNm" column="FILE_GROUP_NM"/>
		<result property="fileRegdate" column="FILE_REGDATE"/>
		<result property="fileGroupTy" column="FILE_GROUP_TY"/>	
		
	</resultMap>
	
	<resultMap type="kr.or.ddit.vo.FileDetailVO" id="fileDetailMap">
		<result property="fileNo" column="FILE_NO"/>
		<result property="fileGroupNo" column="FILE_GROUP_NO"/>
		<result property="fileOriginalName" column="FILE_ORIGINAL_NAME"/>
		<result property="fileSaveName" column="FILE_SAVE_NAME"/>
		<result property="fileExt" column="FILE_EXT"/>
		<result property="fileSize" column="FILE_SIZE"/>
		<result property="fileSaveLocate" column="FILE_SAVE_LOCATE"/>
		<result property="fileMime" column="FILE_MIME"/>
		<result property="fileFancysize" column="FILE_FANCYSIZE"/>
		<result property="fileSaveDate" column="FILE_SAVE_DATE"/>
		<result property="fileDowncount" column="FILE_DOWNCOUNT"/>
	</resultMap>



    <!-- 기존 쿼리문 유지 -->
    <select id="selectMenuList" resultMap="MenuMap">
        SELECT 
            MENU_NO,
            MENU_NM,
            m.CTGRY_NO,
            c.CTGRY_NM,
            MENU_PRICE,
            MENU_CN,
            MENU_REGIST,
            MENU_DEL,
            m.FILE_GROUP_NO,
            fd.FILE_SAVE_LOCATE
        FROM MENU m
		    INNER JOIN CTGRY c ON m.CTGRY_NO = c.CTGRY_NO
		    LEFT JOIN FILE_GROUP fg ON m.FILE_GROUP_NO = fg.FILE_GROUP_NO
		    LEFT JOIN FILE_DETAIL fd ON fg.FILE_GROUP_NO = fd.FILE_GROUP_NO
		    WHERE m.MENU_DEL = 1
		    ORDER BY m.CTGRY_NO ASC, m.MENU_NM ASC
    </select>
    
    <select id="file">
		select * from file_group fg, file_detail fd
		where fg.file_group_no = fd.file_group_no
		and fd.file_group_no=#{fileGroupNo}
    </select>

    <select id="selectMenuByCategory" parameterType="int" resultType="kr.or.ddit.vo.MenuVO">
        SELECT 
            MENU_NO,
            MENU_NM,
            m.CTGRY_NO,
            c.CTGRY_NM,
            MENU_PRICE,
            MENU_CN,
            MENU_REGIST,
            MENU_DEL,
            FILE_GROUP_NO
        FROM 
            MENU m
            INNER JOIN CTGRY c ON m.CTGRY_NO = c.CTGRY_NO
        WHERE 
            MENU_DEL = 1
            AND m.CTGRY_NO = #{ctgryNo}
        ORDER BY
            MENU_NM ASC
    </select>
</mapper>