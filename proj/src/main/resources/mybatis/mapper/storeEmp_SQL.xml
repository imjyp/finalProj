<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.or.ddit.member.jy.mapper.StoreEmpMapper">
	
	<!-- 가맹점 직원 목록 -->
	<select id="listAll" resultType="kr.or.ddit.vo.StoreEmpVO">
		SELECT USER_NO, STORE_NO, POSITION_NO
		FROM  STORE_EMP
		ORDER BY USER_NO
	</select>
	
	<!-- 서로 다른 가맹점으로는 접근할 수 없다. 1이상 : 접근 가능 / 0 : 접근 불가
	public int getUrlAccess(Map<String, Object> map)
	 -->
	<select id="getUrlAccess" parameterType="hashMap" resultType="int">
		SELECT COUNT(*)
		FROM   STORE_EMP
		WHERE  USER_NO = #{userNo} and STORE_NO = #{storeNo}
	</select>
</mapper>