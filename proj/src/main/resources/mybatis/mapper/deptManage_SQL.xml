	</insert>
	
	<update id="updateDept" parameterType="DeptVO" >
		UPDATE DEPT
		SET dept_nm	= #{deptNm},
	    	dept_suprr	= #{deptSuprr}
		WHERE dept_no = #{deptNo}
	</update>
	
	<!-- delete 대신에 update로 상태코드 변경하면 0(삭제상태)로 바꿈 -->
	<update id="deleteDept" parameterType="DeptVO" >
		UPDATE DEPT
		SET dept_state = 0
		WHERE dept_no = #{deptNo}
	</update>
	
	
	
