	<!-- 2번 방법 LEVEL 포함-->
	<select id="getDeptList" resultType="DeptVO">
		SELECT dept_no, dept_nm, dept_suprr, LEVEL						<!-- 계층형 레벨 -->
		FROM dept
		WHERE dept_state = 1				<!-- 삭제되지 않은 부서만 조회 -->
		START WITH dept_suprr IS NULL			<!-- 최상위 부서부터 시작 -->
		CONNECT BY PRIOR dept_no = dept_suprr	<!-- 부모와 자식 부서 관계 연결 -->
		ORDER BY	LEVEL, dept_suprr			<!-- 계층 순으로 정렬 -->
	</select>
	

	
		<!-- 중복 확인 후 데이터 삽입 -->
	<insert id="createDept" parameterType="DeptVO" >
		<!-- 중복 확인 후 데이터 삽입 DEPT_STATE는 DB에서 기본값 1 자동생성 -->
        INSERT INTO DEPT (dept_no, dept_nm, dept_suprr)
    	VALUES ((SELECT NVL(MAX(dept_no), 0) + 1 FROM DEPT), #{deptNm}, #{deptSuprr})
    
