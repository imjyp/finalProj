<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>

<link rel="stylesheet" href="/css/signup.css">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<!-- sweetAlert -->
<link rel="stylesheet" href="/css/sweetalert2.min.css">
<script type="text/javascript" src="/js/sweetalert2.min.js"></script>

<!-- 주소 api -->
<script src="//t1.daumcdn.net/mapjsapi/bundle/postcode/prod/postcode.v2.js"></script>


<script type="text/javascript" src="/js/jquery-3.6.0.js"></script>
<script type="text/javascript" src="/js/signup.js"></script>
<style>
/* 버튼이 우측 상단에 위치하도록 스타일링 */
.dataInput {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    padding: 10px 15px;
    position: relative; /* 버튼이 위치를 잃지 않도록 설정 */
    z-index: 10; /* 버튼이 다른 요소 위로 올라오도록 설정 */
}

.dataInput .btn {
    padding: 8px 12px;
    font-size: 16px;
    border-radius: 5px;
}
</style>
<section class="vh-100 d-flex flex-column align-items-center justify-content-center">
    <!-- 로고와 사이트명
    <div class="header">
    	<a href="/main">
        <img src="/upload/KakaoTalk.png" alt="Logo" class="logo">
        </a>
        <span class="site-name"> 404 NOT COFFEE </span>
    </div>
	 -->
	<!-- 본사/가맹점 선택 탭 -->
	<ul class="nav nav-tabs" id="storeTypeTab" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="bonsa-tab" data-bs-toggle="tab" href="#bonsa" role="tab" 
                onclick="setUserCode(1); showUserForm(1);" aria-controls="bonsa" aria-selected="true">본사</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="store-tab" data-bs-toggle="tab" href="#store" role="tab" 
               onclick="setUserCode(2); showUserForm(2);" aria-controls="store" aria-selected="false" tabindex="-1">가맹점</a>
        </li>
    </ul>
    
    <!-- 상세정보 입력 폼 -->
    <!-- Forms -->
        <form id="userForm" action="/user/details" method="POST">
        	<input type="hidden" name="userNo" value="${userNo}">
            <input type="hidden" id="userCode" name="userCode">
			
			 <!-- 버튼을 탭 위에 배치 -->
		    <div class="dataInput">
		        <button type="button" class="btn-data">✔</button>
		    </div>
		    
            <!-- 공통 필드 -->
            <div class="signup-container">
                <div class="input-group">
                    <label for="userBirth">생일</label>
                    <input type="date" id="userBirth" name="userBirth" class="input-field" required>
                </div>
                <div class="input-group">
                    <label for="emailId">이메일</label>
                     <div class="email-container d-flex">
                        <input type="text" id="emailId" name="emailId" class="input-field" placeholder="이메일" required>
                        <select name="emailDomain" id="emailDomain" class="form-select">
                            <option value="">선택해주세요</option>
                            <option value="gmail.com">gmail.com</option>
                            <option value="naver.com">naver.com</option>
                            <option value="daum.net">daum.net</option>
                            <option value="custom">직접 입력</option>
                        </select>
                    </div>
                    <input type="text" id="customEmailDomain" name="customEmailDomain" class="input-field custom-domain" placeholder="도메인 입력" style="display:none;">
                    <input type="hidden" id="userMail" name="userMail">
                </div>
                <div class="input-group">
                    <label for="userZip">주소</label>
                    <div style="display: flex; align-items: center;">
	                    <input type="text" id="userZip" name="userZip" class="input-field" readonly required>
	                    <button type="button" id="btnPost" class="btn-post">우편번호 검색</button>
             		</div>
                </div>
                <div class="input-group">
                    <input type="text" id="userAddr1" name="userAddr1" class="input-field" placeholder="주소" required>
                </div>
                <div class="input-group">
                    <input type="text" id="userAddr2" name="userAddr2" class="input-field" placeholder="상세주소">
                </div>
                <div class="input-group">
                    <label for="userIndate">입사일</label>
                    <input type="date" id="userIndate" name="userIndate" class="input-field" required>
                </div>
                <!-- 직책 추가 -->
                <div class="input-group">
                    <label>직책</label>
                    <select name="positionNo" id="positionNo" class="form-select" required>
                   	 <option value="">직책</option>
                        <c:forEach var="positionVO" items="${positionList}"  varStatus="stat">
                            <option value="${positionVO.positionNo}">${positionVO.positionNm}</option>
                        </c:forEach>
                    </select>
                </div> 
            

            <!-- 탭 전환 필드 -->
            <div class="tab-content" id="storeTypeContent">
                <div class="tab-pane fade show active" id="bonsa" role="tabpanel" aria-labelledby="bonsa-tab">
                    <input type="hidden" id="bonsaCode" value="1">
                    <!-- 부서 추가 -->
	                <div class="input-group">
	                 <label>부서</label>
	                    <select name="deptNo" id="deptNo" class="form-select" >
	                   	<option value="">부서</option>
	                     <c:forEach var="deptVO" items="${deptList}" varStatus="stat">
	                        <option value="${deptVO.deptNo}">${deptVO.deptNm}</option>
	                     </c:forEach>
	                     </select>
	                  </div>
	                  <!-- 직책 추가 -->
                </div>
                <div class="tab-pane fade" id="store" role="tabpanel" aria-labelledby="store-tab">
                    <input type="hidden" id="storeCode" value="2">
                    <!-- 소속 가맹점 번호 추가 -->
	                <div class="input-group">
	                    <label>소속 가맹점 번호</label>
	                    <input type="text" class="input-field" name="storeNo" placeholder="가맹점 번호" >
	                </div>
                    <!-- 소속 가맹점명 추가 -->
	                <div class="input-group">
	                    <label>소속 가맹점 이름</label>
	                    <input type="text" class="input-field" name="storeNm" placeholder="가맹점 이름" >
	                </div>
	                <!-- 직책 추가 -->
                </div>
            </div>
            <button type="submit" class="btn-signup">권한 요청</button>
            </div>
            
        </form>

    <!-- Footer -->
    <footer class="footer">
    </footer>
</section>

<script>
<!-- setUserCode, showUserForm 함수 -->
document.addEventListener('DOMContentLoaded', function() {
    console.log("체킁 DOM");
    
    // 초기값 설정
    setUserCode(1);
    showUserForm(1);
});

//사용자 코드 설정만 처리하는 함수
function setUserCode(userCode) {
	console.log("전달된 userCode 값 : ", userCode);
    
    if(userCode === 1 || userCode ===2){
   	document.getElementById('userCode').value = userCode;
    console.log("userCode : " + userCode);
    }else{
    console.log("유효하지 않은 userCode 값입니다.");
   	}
}

//탭 전환 시 사용자 코드에 맞는 양식 표시만 처리하는 함수
function showUserForm(userCode) {
	console.log("showUserForm 체킁");
	
    if (userCode === 1) {
        // 본사 선택
        document.getElementById('bonsa').style.display = 'block';
        document.getElementById('store').style.display = 'none';
        document.getElementById('deptNo').style.display = 'inline-block';
        document.getElementById('storeNo').style.display = 'none';
    } else if (userCode === 2) {
        // 가맹점 선택
        document.getElementById('store').style.display = 'block';
        document.getElementById('bonsa').style.display = 'none';
        document.getElementById('storeNo').style.display = 'inline-block';
        document.getElementById('deptNo').style.display = 'none';
    }
}
</script>

