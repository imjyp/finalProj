<title>가맹점 발주</title>
    <div id="main">
    <%@ include file="../include/top.jsp" %>
     <header class="mb-3">
         <a href="#" class="burger-btn d-block d-xl-none">
             <i class="bi bi-justify fs-3"></i>
         </a>
     </header>
 <div class="card">
   <div class="card-header">
       <h2 class="card-title">발주 / 주문</h4>
       <p>Tab value: ${tab}</p>
<%--        <c:set var="tab" value="${tab != null ? tab : 'order'}" /> --%>
   </div>
   <p>${itemVO }</p>
   <div class="card-content">
       <div class="card-body">
           <!-- 발주 / 견적 / 계산 / 발주 관리 탭 -->
           <ul class="nav nav-tabs" id="orderStatusTab" role="tablist">
               <li class="nav-order" role="presentation">
               <a class="nav-link ${tab == 'order' ? 'active' : ''}" id="order-tab" data-bs-toggle="tab" href="#order" role="tab" 
                   class="order" aria-controls="itemList" aria-selected="true">발주/주문</a>
               </li>
               <li class="nav-item" role="presentation">
               <a class="nav-link ${tab == 'estimate' ? 'active' : ''}" id="estimate-tab" data-bs-toggle="tab" href="#estimate" role="tab"
                   class="estimate" aria-controls="estimate" aria-selected="false" tabindex="-1">견적</a>
               </li>
               <li class="nav-item" role="presentation">
               <a class="nav-link ${tab == 'bill' ? 'active' : ''}" id="bill-tab" data-bs-toggle="tab" href="#bill" role="tab"
                   class="bill" aria-controls="bill" aria-selected="false" tabindex="-1">계산</a>
               </li>
               <li class="nav-item" role="presentation">
               <a class="nav-link" id="status-tab" data-bs-toggle="tab" href="#status" role="tab"
                   class="status" aria-controls="status" aria-selected="false" tabindex="-1">발주/주문 관리</a>
               </li>	
           </ul>
           
           <div class="dataTable-top" style="justify-content: right; display: flex;">
           	<form>
           	<!-- 검색  -->
           	<div class="dataTable-search" >
           		<input type="text" id="krd" name="keyword" value="${param.keyword}" 
           			class="dataTable-input" placeholder="" aria-controls="tby">
          		<button type="button" id="btnSearch" class="btn btn-dark rounded-pill">검색</button>
           	</div>
            </form>
           </div>
           <!-- 탭 콘텐츠 -->
		   <div class="tab-content">
           <%-- 발주/주문 (품목리스트)--%>
		   <div class="tab-pane fade ${tab == 'item' ? 'show active' : ''}" id="order" role="tabpanel" aria-labelledby="order-tab">
<%-- 		   <c:if test="${tab == 'order'}"> --%>
           <div>
           	<h4 class="card-title">품목리스트</h4>
           </div>
           <div class="table-responsive">
               <table class="table table-lg">
                   <thead>
                       <tr>
                           <th>
                           <div class="form-check">
                               <div class="custom-control custom-checkbox">
<!--                                    <input type="checkbox" class="form-check-input form-check-secondary form-check-glow" name="customCheck" id="checkboxGlow2"> -->
       								<input type="checkbox" class="form-check-input form-check-secondary form-check-glow" 
       									name="customCheck_${itemVO.itemNo}" id="checkboxGlow_${stat.index}">
                               </div>
                           </div>
                           </th>
                           <th>번호</th>
                           <th>품목 이름</th>
                           <th>원가</th>
                           <th>판매가</th>
                           <th>수량</th>
                           <th>총 금액</th>
                           <th>발주일</th>
                       </tr>
                   </thead>
                   <tbody id="tby">
                   <c:forEach var="itemVO" items="${articlePage1.content}" varStatus="stat">
                   	<tr>
                   		<td class="text-bold-500">
                 			<div class="custom-control custom-checkbox">
                             </div>
                   		</td>
                         <td class="text-bold-500">${itemVO.itemNo}</td>
                         <td class="text-bold-500">${itemVO.itemNm}</td>
                         <td class="text-bold-500">${itemVO.itemPrice}</td>
                         <td class="text-bold-500">${itemVO.salePrice}</td>
                         <td class="text-bold-500">수량</td>
                         <td class="text-bold-500">총 금액</td>
                         <td class="text-bold-500">발주일</td>
                     </tr>
                   </c:forEach>
                   </tbody>
               </table>
                <div class="card-footer" id="divPagingArea">
	            <nav aria-label="Page navigation example">
	               <ul class="pagination pagination-primary  justify-content-center">
	                   <li class="page-item">
	                   	${articlePage1.pagingArea}
					  </li>
	               </ul>
	            </nav>
	           </div>
           </div>
<%--            </c:if> --%>
           </div>
            <%-- 견적 --%>
		    <div class="tab-pane fade ${tab == 'estimate' ? 'show active' : ''}" id="estimate" role="tabpanel" aria-labelledby="estimate-tab">
<%--             <c:if test="${tab == 'estimate'}"> --%>
		        <div>
		            <h4 class="card-title">견적 리스트</h4>
		        </div>
		        <div class="table-responsive">
		            <table class="table table-lg">
		                <thead>
		                    <tr>
		                        <th>번호</th>
		                        <th>발주 번호</th>
		                        <th>제목</th>
		                        <th>발주 상태</th>
		                    </tr>
		                </thead>
		                <tbody>
		                    <c:forEach var="estimateVO" items="${articlePage2.content}" varStatus="stat">
		                        <tr>
		                            <td>${estimateVO.estimateNo}</td>
		                            <td>${estimateVO.storeOrderNo}</td>
		                            <td>${estimateVO.estimateTitle}</td>
		                            <td>발주상태</td>
		                        </tr>
		                    </c:forEach>
		                </tbody>
		            </table>
		           <div class="card-footer" id="divPagingArea">
		           <nav aria-label="Page navigation example">
		               <ul class="pagination pagination-primary  justify-content-center">
		                   <li class="page-item">
		                   	${articlePage2.pagingArea}
						  </li>
		               </ul>
		           </nav>
		           </div>
		        </div>
<%-- 		    </c:if> --%>
		    </div>
		    <%-- 계산 --%>
		    <div class="tab-pane fade ${tab == 'bill' ? 'show active' : ''}" id="bill" role="tabpanel" aria-labelledby="bill-tab">
<%-- 		    <c:if test="${tab == 'bill'}"> --%>
		        <h4 class="card-title">계산 리스트</h4>
		        <div class="table-responsive">
		            <table class="table table-lg">
		                <thead>
		                    <tr>
		                        <th>번호</th>
		                        <th>견적 번호</th>
		                        <th>제목</th>
		                        <th>발주 상태</th>
		                    </tr>
		                </thead>
		                <tbody>
		                    <c:forEach var="billVO" items="${articlePage3.content}" varStatus="stat">
		                        <tr>
		                            <td>${billVO.billNo}</td>
		                            <td>${billVO.estimateNo2}</td>
		                            <td>${billVO.billTitle}</td>
		                            <td>발주상태</td>
		                        </tr>
		                    </c:forEach>
		                </tbody>
		            </table>
		            <div class="card-footer" id="divPagingArea">
		            <nav aria-label="Page navigation example">
		               <ul class="pagination pagination-primary  justify-content-center">
		                   <li class="page-item">
		                   	${articlePage3.pagingArea}
						  </li>
		               </ul>
		           </nav>
		           </div>
		        </div>
<%-- 			</c:if> --%>
		    </div>
		    <%-- 발주/주문 관리 -->
<%-- 		    <c:when test=""> --%>
<%-- 		    --%>
		    <div class="tab-pane fade" id="status" role="tabpanel" aria-labelledby="status-tab">
		        <h4 class="card-title">발주/주문 관리</h4>
		        <%-- 발주/주문 관리 내용 추가 --%>
		    </div>
<%-- 		    </c:when> --%>
        </div>
    </div>
</div>
</div>
