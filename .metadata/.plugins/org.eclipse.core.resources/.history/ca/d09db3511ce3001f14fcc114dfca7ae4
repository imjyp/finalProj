$("#ok").on('click',function(){
	//값 받아서 data2에 넣기
	
	let storeNm = $("#storeNm").val();
	let storeZip = $("#userZip").val();
	let storeAddr1 = $("#userAddr1").val();
	let storeAddr2 = $("#userAddr2").val();
	let storeOpenDate = $("#date").val();
	
	let data2={storeNm:storeNm,
			storeZip:storeZip,
			storeAddr1:storeAddr1,
			storeAddr2:storeAddr2,
			storeOpenDate:storeOpenDate};
	console.log("insert!!", data2);
	
	  if (!storeNm || !storeZip || !storeAddr1 || !storeAddr2 || !storeOpenDate) {
	        alert("모든 입력란을 채워주세요.");
	        
	        return;
	    }
	 $.ajax({
			url:"/gmjInsert",
			type: 'POST',
		    contentType:"application/json;charset=utf-8",
		 	data:JSON.stringify(data2),
		 	dataType:"json",
		    success: function(response) {
		    	 if (response>0) {
		                alert("등록 완료되었습니다.");
		                $(".modallll").modal("hide");
		                list();
		            } else {
		                alert("등록 실패했습니다.");
		            }
		     }
			
		}) 
	
	
})


