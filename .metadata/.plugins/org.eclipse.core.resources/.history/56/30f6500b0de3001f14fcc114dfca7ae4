<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta name="csrf-token" content="${_csrf.token}" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
     <%@ include file="../include/header.jsp"%>
     
    <title>나의 알림</title>
    
    <link rel="shortcut icon" href="/dist/assets/compiled/svg/favicon.svg" type="image/x-icon">
    <link rel="shortcut icon" href="data:image/png;base64," type="image/png">
    
<!--     <link rel="stylesheet" href="/dist/assets/compiled/css/application-email.css"> -->
<!--     <link rel="stylesheet" href="/dist/assets/compiled/css/app.css"> -->
<!--     <link rel="stylesheet" href="/dist/assets/compiled/css/app-dark.css"> -->
	
	<!-- Bootstrap CSS 
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	-->
</head>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<style>
  
/* 뱃지만 개별적으로 가운데 정렬 */
.tableType01 td .badge {
    display: inline-block !important;
    text-align: center;
    width: 100%; /* 뱃지가 전체 영역에서 중앙에 오도록 설정 */
}

.swal-body{
	font-family : 'NotoSansKR' ; 
	font-size :500 !important;
}

#main {
  margin-top: 141px; 
}
 /* 
.tableType01 th:nth-child(2),
.tableType01 td:nth-child(2) {
    white-space: nowrap!important;
}
*/
  
#table1 th, #table1 td {
    text-align: center;
    vertical-align: middle; /* 세로 정렬도 가운데로 */
  }



</style>
<body>
       
<!--     <script src="/dist/assets/static/js/initTheme.js"></script> -->
<div id="main">
   <%@ include file="../include/top.jsp"%>

  <div class="card">
  <div class="card-header">
    <div class="container-fluid">
      <div class="row align-items-center">
        
        <!-- 왼쪽: 제목과 브레드크럼 (col-md-6) -->
        <div class="col-md-6 d-flex align-items-center">
          <nav aria-label="breadcrumb" class="ms-3">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="/main">Home</a></li>
              <li class="breadcrumb-item active"><a href="/alert">나의 알림</a></li>
            </ol>
          </nav>
        </div>
        
        
      </div> <!-- /.row.align-items-center -->
    </div> <!-- /.container-fluid -->
  </div> <!-- /.card-header -->
</div> <!-- /.card -->


   <div class="card-content">

       <!-- Table with outer spacing -->
       <div class="tableType01" >
           <table class="board" id="table1" style="width:100% !important">
               <thead>
                   <tr>
	                    <th class="noline text-center">순번</th>
						<th class="text-center">유형</th>
						<th class="text-center">내용</th>
						<th class="text-center">수신일</th>
						<th class="text-center">상태</th>
                   </tr>
               </thead>
               <tbody id="alertsTby">
               	<c:forEach var="alert" items="${alerts}">
                   <tr>
                       <td class="text-center">${alert.rnum}</td>
                       <td class="text-center">
                       	<c:choose>
                               <c:when test="${alert.alertTy == 2}">
                                   댓글
                               </c:when>
                               <c:when test="${alert.alertTy == 3}">
                                   안전재고
                               </c:when>
                               <c:when test="${alert.alertTy == 4}">
                                   계산서 요청
                               </c:when>
                               <c:when test="${alert.alertTy == 5}">
                                   계산서 발행
                               </c:when>
                               <c:otherwise>
                                   결재
                               </c:otherwise>
                        </c:choose>
                       
                      </td>
                       <td class="text-start"><a href="${alert.alertUrl}" onclick="updAlertChk(${alert.alertNo});">${alert.alertCn}</a></td>
                       <td class="text-center">
                       	<fmt:formatDate value="${alert.alertCreate}" pattern="yyyy-MM-dd HH:mm" />
                       </td>
                       <td class="text-center">
                           <c:choose>
                               <c:when test="${alert.alertChk == 1}">
                                   <span class="badge bg-warning" style="display: inline-block!important;">미확인</span>
                               </c:when>
                               <c:otherwise>
                                   <span class="badge bg-success" style="display: inline-block!important;">확인</span>
                               </c:otherwise>
                           </c:choose>
                       </td>
                   </tr>
               </c:forEach>
               </tbody>
           </table>
       </div>
           <div class="card-footer ">
				<div id="divPagingArea" class="pagination pagination-warning justify-content-center divPagingArea"></div>
		  </div>
       
   </div> <!-- /.card-content -->
</div> <!-- /#main -->
<%@ include file="../include/footer.jsp"%>
</body>    


</html>
