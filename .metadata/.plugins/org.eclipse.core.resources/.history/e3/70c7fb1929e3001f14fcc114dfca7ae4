<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login</title>



<link rel="shortcut icon" href="/dist/assets/compiled/svg/favicon.svg" type="image/x-icon">
<link rel="shortcut icon"
	href="data:image/png;base64,"
	type="image/png">
<link rel="stylesheet" href="/dist/assets/compiled/css/app.css">
<link rel="stylesheet" href="/dist/assets/compiled/css/app-dark.css">
<link rel="stylesheet" href="/dist/assets/compiled/css/auth.css">
</head>
<style>
.logo {
    width: 80px; /* 로고 크기 */
    height: auto; /* 비율 유지 */
}

.site-name {
    font-size: 1.5rem;
    font-weight: bold;
    color: #fff;
}
.footer {
    margin-top: 20px;
    text-align: center;
    width: 100%;
    font-size: 0.9rem;
    color: #777;
}

</style>

<body>
	<div id="auth">

		<div class="row h-100">
			<div class="col-lg-5 col-12">
				<div id="auth-left">
					<div class="auth-logo">
						<a href="/">
						<img src="/upload/.png" alt="Logo"></a>
					</div>
					<h1 class="auth-title">LOG IN</h1>
					<p class="auth-subtitle mb-5"></p>

					<form action="/login" method="POST">
						<div class="form-group position-relative has-icon-left mb-4">
							<input type="text" class="form-control form-control-xl" name="username" value="" placeholder="아이디" required>
							<div class="form-control-icon">
								<i class="bi bi-person"></i>
							</div>
						</div>
						<div class="form-group position-relative has-icon-left mb-4">
							<input type="password" class="form-control form-control-xl" name ="password" value="" placeholder="비밀번호" required>
							<div class="form-control-icon">
								<i class="bi bi-shield-lock"></i>
							</div>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="sys" id="sys">
						    <label class="form-check-label text-gray-600" for="sys">시스템관리자</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="gmj" id="gmj">
						    <label class="form-check-label text-gray-600" for="gmj">가맹점주</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="jj" id="jj">
						    <label class="form-check-label text-gray-600" for="jj">재정/회계</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="gy" id="gy">
						    <label class="form-check-label text-gray-600" for="gy">경영</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="mr" id="mr">
						    <label class="form-check-label text-gray-600" for="mr">물류</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="jr" id="jr">
						    <label class="form-check-label text-gray-600" for="jr">전략/기획</label>
						</div>
						<div class="form-check form-check-lg d-flex align-items-end">
						    <input class="form-check-input me-2" type="radio" name="login" value="is" id="is">
						    <label class="form-check-label text-gray-600" for="is">인사/행정</label>
						</div>

						<button class="btn btn-warning btn-block btn-lg shadow-lg mt-5">로그인</button>
					</form>
					<div class="text-center mt-5 text-lg fs-4">
						<p>
							<a class="font-bold" href="/findId" style="display: inline; margin-right: 10px;">아이디 찾기</a>
						</p>
						<p>
							<a class="font-bold" href="/findPassword" style="display: inline;">비밀번호 찾기</a>
						</p>
						<p class="text-gray-600">
							아직 회원이 아니신가요?
							<a href="/signup" class="font-bold">회원가입</a>
						</p>
						
					</div>
				</div>
			</div>
			<div class="col-lg-7 d-none d-lg-block">
				<div id="auth-right"></div>
			</div>
		<!-- Footer -->
	    <div class="footer">
	        <%@ include file="../include/footer.jsp"%>
	    </div>
		</div>
	</div>
</body>
</html>


<script>
const loginData = {
    sys: {
        username: 'a001',
        password: 'aaaa'
    },
    gmj: {
        username: 'gmj001',
        password: 'aaaa'
    },
    gmjjw: {
        username: 'gmjjw',
        password: 'aaaa'
    },
    jj: {
        username: 'j001',
        password: 'aaaa'
    },
    gy: {
        username: 'a555',
        password: 'aaaa'
    },
    mr: {
        username: 'e7e',
        password: 'aaaa'
    },
    jr: {
        username: 'asdf432',
        password: 'aaaa'
    },
    is: {
        username: 'b001',
        password: 'aaaa'
    },
};

document.querySelectorAll('input[name="login"]').forEach(function(radioBtn) {
    radioBtn.addEventListener('change', function() {
        const selectedValue = document.querySelector('input[name="login"]:checked').value;

        if (selectedValue && loginData[selectedValue]) {
            document.querySelector('input[name="username"]').value = loginData[selectedValue].username;
            document.querySelector('input[name="password"]').value = loginData[selectedValue].password;
        }
    });
});



</script>