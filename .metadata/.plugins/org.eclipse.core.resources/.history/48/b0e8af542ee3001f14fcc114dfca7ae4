<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<!DOCTYPE html>
<html lang="en">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login</title>



<link rel="shortcut icon" href="/dist/assets/compiled/svg/favicon.svg" type="image/x-icon">
<link rel="shortcut icon"
	href="data:image/png;base64,"
	type="image/png">
<link rel="stylesheet" href="/dist/assets/compiled/css/app.css">
<link rel="stylesheet" href="/dist/assets/compiled/css/app-dark.css">
</head>
<style>
body {
    margin: 0;
    padding: 0;
    font-family: 'Noto Sans KR', sans-serif;
    background-color: #fff; /* 흰 배경 */
    box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
}

.header {
    position: absolute;
    top: 20px; /* 위쪽 여백 */
    left: 20px; /* 왼쪽 여백 */
    display: flex;
    align-items: center;
    gap: 10px; /* 로고와 사이트명 간 간격 */
}

.logo {
    width: 100px; /* 로고 크기 */
    height: auto; /* 비율 유지 */
    padding-right: -10;
}

section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: auto; /* 화면 높이 */
    width: 100%;
    position: relative;
    padding: 30px 0;
}

.signup-container {
    text-align: left;
    width: 100%;
    max-width: 400px; /* 폼 최대 너비 */
    padding: 0 20px;
    box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15); 
    border-radius: 4px;
}

.signup-container h1 {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 20px;
    font-weight: bold;
    margin-left:-25;
}

/* 로고와 회원가입 제목을 한 줄에 배치 */
.signup-header {
    display: flex;
    align-items: center;
    gap: 20px;  /* 로고와 제목 사이 간격 */
    margin-bottom: 20px;
    justify-content: center;
    margin-left: -28;
}

.form-control {
    margin-bottom: 15px;
}

.form-control label {
    display: block;
    margin-bottom: 5px;
    font-size: 0.9rem;
    color: #333;
    font-weight: bold;
}

.form-control{
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
}


/* 설명 문구 스타일 */
.field-description {
    font-size: 1rem; /* 작고 읽기 쉬운 크기 */
    color: #6c757d; /* 약간 어두운 회색 */
    margin-top: 5px; /* 위 요소와 간격 */
    line-height: 1.4; /* 줄 간격 */
}


.btn-login {
    width: 100%;
    padding: 10px;
    background-color: #FFB000; 
    color: rgb(50, 58, 67);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    margin-top: 15px;
    font-weight: bold;
}

.btn-signup:hover {
    background-color: #FFD93D;
}

.find{
	display: flex; 
	align-items: center;
	justify-content : center;	
}

.footer a {
	color:#4F200D;
	font-weight:bold;

}
</style>

<body>
<section class="center-page vh-100 d-flex flex-column align-items-center justify-content-center">
   
<div class="signup-container">
	 <div class="signup-header">
    	<a href="/main">
        	<img src="/upload/logo.png" alt="Logo" class="logo">
        </a>
        <h1>로그인</h1>
       </div>

	<form action="/login" method="POST">
		<div class="form-group position-relative has-icon-left mb-4">
			<input type="text" class="form-control form-control-xl" name="username" value="" placeholder="아이디" required>
			<div class="form-control-icon">
				<i class="bi bi-person"></i>
			</div>
		</div>
		<div class="form-group position-relative has-icon-left mb-4">
			<input type="password" class="form-control form-control-xl" name ="password" value="" placeholder="비밀번호" required>
			<div class="form-control-icon">
				<i class="bi bi-shield-lock"></i>
			</div>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="sys" id="sys">
		    <label class="form-check-label text-gray-600" for="sys">시스템관리자</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="gmj" id="gmj">
		    <label class="form-check-label text-gray-600" for="gmj">가맹점주</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="jj" id="jj">
		    <label class="form-check-label text-gray-600" for="jj">재정/회계</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="gy" id="gy">
		    <label class="form-check-label text-gray-600" for="gy">경영</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="mr" id="mr">
		    <label class="form-check-label text-gray-600" for="mr">물류</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="jr" id="jr">
		    <label class="form-check-label text-gray-600" for="jr">전략/기획</label>
		</div>
		<div class="form-check form-check-lg d-flex align-items-end">
		    <input class="form-check-input me-2" type="radio" name="login" value="is" id="is">
		    <label class="form-check-label text-gray-600" for="is">인사/행정</label>
		</div>

		<button class="btn-login">로그인</button>
	</form>
	<div class="text-center mt-5 text-lg fs-4">
		<div class="footer">
		<div class="find">
			<p class="field-description">
				<a class="font-bold" href="/findId" style="display: inline; margin-right: 10px;">아이디 찾기</a>
			</p>
			<p class="field-description">
				<a class="font-bold" href="/findPassword" style="display: inline;">비밀번호 찾기</a>
			</p>
		</div>
		<p class="field-description">
			아직 회원이 아니신가요?
			<a href="/signup" class="font-bold">회원가입</a>
		</p>
		</div>	
	</div>
		</div>
			</div>
		<!-- Footer -->
	    <div class="footer">
	        <%@ include file="../include/footer.jsp"%>
	    </div>
		</div>
	</div>
	</section>
</body>
</html>


<script>
const loginData = {
    sys: {
        username: 'a001',
        password: 'aaaa'
    },
    gmj: {
        username: 'gmj001',
        password: 'aaaa'
    },
    gmjjw: {
        username: 'gmjjw',
        password: 'aaaa'
    },
    jj: {
        username: 'j001',
        password: 'aaaa'
    },
    gy: {
        username: 'a555',
        password: 'aaaa'
    },
    mr: {
        username: 'e7e',
        password: 'aaaa'
    },
    jr: {
        username: 'asdf432',
        password: 'aaaa'
    },
    is: {
        username: 'b001',
        password: 'aaaa'
    },
};

document.querySelectorAll('input[name="login"]').forEach(function(radioBtn) {
    radioBtn.addEventListener('change', function() {
        const selectedValue = document.querySelector('input[name="login"]:checked').value;

        if (selectedValue && loginData[selectedValue]) {
            document.querySelector('input[name="username"]').value = loginData[selectedValue].username;
            document.querySelector('input[name="password"]').value = loginData[selectedValue].password;
        }
    });
});



</script>