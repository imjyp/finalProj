/* 버튼이 우측 상단에 위치하도록 스타일링 */
.dataInput {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    padding: 10px 15px;
    position: relative; /* 버튼이 위치를 잃지 않도록 설정 */
    z-index: 10; /* 버튼이 다른 요소 위로 올라오도록 설정 */
}

/* 중복확인 버튼 전용 스타일 */
.btn-dup-check {
    background-color: #FFD93D;
    color: rgb(50, 58, 67);
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s;
    white-space: nowrap;
    font-weight: bold;
}

.btn-dup-check:hover {
    background-color: #FFD93D;
}

.btn-data{
	background-color: #FFD93D;
    color: rgb(50, 58, 67);
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s;
}

/* 로고와 회원가입 제목을 한 줄에 배치 */
.signup-header,
.details-header {
    display: flex;
    align-items: center;
    gap: 20px;  /* 로고와 제목 사이 간격 */
    margin-bottom: 20px;
    justify-content: center;
    margin-left: -28;
}
	
/* details.jsp 전용 컨테이너 스타일 */
.details-container {
    width: 90%;
    max-height: 90vh;        /* 뷰포트 높이의 90%로 제한 */
    padding: 10px 15px;      /* 내부 여백 축소 */
    overflow: hidden;        /* 스크롤 없이 모두 표시 (필요에 따라 overflow 조정) */
    font-size: 0.9rem;       /* 폰트 크기를 약간 줄여서 더 많은 내용이 들어가도록 함 */
}

/* 입력 필드 간 간격 줄이기 */
.details-container .input-group {
    margin-bottom: 8px;
}

/* 제목 크기 조정 */
.details-container .details-header h1 {
    font-size: 1.5rem;
    margin: 0;
}