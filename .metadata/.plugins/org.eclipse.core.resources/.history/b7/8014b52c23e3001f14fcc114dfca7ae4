body {
    margin: 0;
    padding: 0;
    font-family: 'Noto Sans KR', sans-serif;
    background-color: #fff; /* 흰 배경 */
    box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15);
}

.header {
    position: absolute;
    top: 20px; /* 위쪽 여백 */
    left: 20px; /* 왼쪽 여백 */
    display: flex;
    align-items: center;
    gap: 10px; /* 로고와 사이트명 간 간격 */
}

.logo {
    width: 100px; /* 로고 크기 */
    height: auto; /* 비율 유지 */
    padding-right: -10;
}

.header .site-name {
    font-size: 1.5rem;
    font-weight: bold;
    color: #4F200D;
}

section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100vh; /* 화면 높이 */
    width: 100%;
    position: relative;
}

.signup-container {
    text-align: left;
    width: 100%;
    max-width: 400px; /* 폼 최대 너비 */
    padding: 0 20px;
/*     box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15); */
/*     border-radius: 4px; */
}

.signup-container h1,
.details-container h1{
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 20px;
    font-weight: bold;
    margin-left:-25;
}

.input-group {
    margin-bottom: 15px;
}

.input-group label {
    display: block;
    margin-bottom: 5px;
    font-size: 0.9rem;
    color: #333;
    font-weight: bold;
}

.input-field {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
}

/* 설명 문구 스타일 */
.field-description {
    font-size: 0.8rem; /* 작고 읽기 쉬운 크기 */
    color: #6c757d; /* 약간 어두운 회색 */
    margin-top: 5px; /* 위 요소와 간격 */
    line-height: 1.4; /* 줄 간격 */
}

.phone-inputs {
    display: flex;
    gap: 10px;
}

.input-field-phone {
    width: calc(33.3% - 6px);
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.9rem;
}

.btn-signup {
    width: 100%;
    padding: 10px;
    background-color: #4F200D; 
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    margin-top: 15px;
    font-weight: bold;
}

.btn-signup:hover {
    background-color: #856543;
}

.footer {
    margin-top: 20px;
    text-align: center;
    width: 100%;
    font-size: 0.9rem;
    color: #777;
}

/* 본사/가맹점 nav-tab  */

/* 본사 폼은 기본적으로 표시 */
#bonsa {
    display: block;
}

/* 가맹점 폼은 기본적으로 숨김 */
#store {
    display: none;
}

/* 탭 활성화 시 상태 전환 */
.tab-pane.show.active {
    display: block;
}

.nav-tabs .nav-link.active {
    border: none;
    position: relative;
    color: #F5F5DC;
}

.nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link {
    color: var(--bs-nav-tabs-link-active-color);
    background-color: var(--bs-nav-tabs-link-active-bg);
    border-color: var(--bs-nav-tabs-link-active-border-color);
}
.nav-tabs, .nav-tabs .nav-link {
    border: none;
}
.nav-tabs .nav-link {
    margin-bottom: calc(-1* var(--bs-nav-tabs-border-width));
    border: var(--bs-nav-tabs-border-width) solid transparent;
    border-top-left-radius: var(--bs-nav-tabs-border-radius);
    border-top-right-radius: var(--bs-nav-tabs-border-radius);
}
.nav-link {
    display: block;
    padding: var(--bs-nav-link-padding-y) var(--bs-nav-link-padding-x);
    font-size: var(--bs-nav-link-font-size);
    font-weight: var(--bs-nav-link-font-weight);
    color: var(--bs-nav-link-color);
    text-decoration: none;
    background: none;
    border: 0;
    transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out;
}
a {
    text-decoration: none;
}
a {
    color: rgba(var(--bs-link-color-rgb), var(--bs-link-opacity, 1));
    text-decoration: underline;
}
*, *:before, *:after {
    box-sizing: border-box;
}
