<style>
/* 버튼이 우측 상단에 위치하도록 스타일링 */
.dataInput {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    padding: 10px 15px;
    position: relative; /* 버튼이 위치를 잃지 않도록 설정 */
    z-index: 10; /* 버튼이 다른 요소 위로 올라오도록 설정 */
}

/* 중복확인 버튼 전용 스타일 */
.btn-dup-check {
    background-color: #4F200D;
    color: #fff;
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 10px;
    cursor: pointer;
    transition: background-color 0.3s;
     white-space: nowrap;
}

.btn-dup-check:hover {
    background-color: #4F200D;
}

/* 로고 사이즈 키우기 */
.logo {
    width: 150px;  /* 기존보다 큰 사이즈로 조정 */
    height: auto;
}
</style>

<section class="vh-100 d-flex flex-column align-items-center justify-content-center">
    <!-- 로고와 사이트명 -->
    <div class="header">
    	<a href="/main">
        <img src="/upload/logo.png" alt="Logo" class="logo">
        </a>
        <span class="site-name">CAFE@BEAN</span>
    </div>

    <!-- 회원가입 폼 -->
    <div class="signup-container">
        <h1>회원가입</h1>
        <form action="/user" method="POST">
            <!-- Form fields -->
           
            <div class="input-group">
                <label>이름</label>
                <input type="text" class="input-field" name="userNm" placeholder="이름" required>
            </div>
            <div class="input-group">
			    <label>아이디</label>
			    <p class="field-description">다른 회원과 겹치지 않도록 입력해주세요. <br> (영어, 숫자 포함 4 ~ 15자)</p>
			    <div style="display: flex; align-items: center;">
			        <input type="text" class="input-field" name="userNo" 
			        	id="userNo" placeholder="아이디" required>
			        <button type="button" id="btnIdDupChk" class="btn-dup-check" style="margin-left: 10px;">중복확인</button>
			    </div>
			</div>
            <div class="input-group">
                <label>비밀번호</label>
                <p class="field-description">영문, 숫자, 특수문자를 포함한 <br> 8자 이상의 비밀번호를 입력해주세요.</p>
                <input type="password" class="input-field" name="userPw" 
                	id="userPw" placeholder="비밀번호" required>
            </div>
            <div class="input-group">
                <label>비밀번호 확인</label>
                <input type="password" class="input-field" name="userPwCheck" placeholder="비밀번호 확인" required>
            </div>
            <div class="input-group">
                <label>연락처</label>
                <div class="phone-inputs">
                    <input type="text" class="input-field-phone" name="userPhone1" placeholder="010" required>
                    <input type="text" class="input-field-phone" name="userPhone2" placeholder="1234" required>
                    <input type="text" class="input-field-phone" name="userPhone3" placeholder="1234" required>
                </div>
              	<!-- 합쳐진 연락처를 담을 숨겨진 input 필드 -->
    			<input type="hidden" name="userPhone" id="userPhone">  
            </div>
            <button type="submit" class="btn-signup">회원가입 요청</button>
        </form>
    </div>

    <!-- Footer 
    <footer class="footer">
    </footer>
    
    -->
</section>


